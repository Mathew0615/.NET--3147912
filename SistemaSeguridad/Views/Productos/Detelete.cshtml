@model SistemaSeguridad.Models.Producto

@{
    ViewData["Title"] = "Eliminar producto";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">

            <div class="card shadow-sm border-0">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">Eliminar producto</h5>
                </div>
                <div class="card-body">

                    <p>¿Seguro que deseas eliminar este producto?</p>

                    <dl class="row">
                        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Nombre)</dt>
                        <dd class="col-sm-8">@Model.Nombre</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Precio)</dt>
                        <dd class="col-sm-8">@Model.Precio.ToString("C")</dd>
                    </dl>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-end">
                            <a asp-action="Index" class="btn btn-outline-secondary me-2">Cancelar</a>
                            <button type="submit" class="btn btn-danger">Eliminar</button>
                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>
