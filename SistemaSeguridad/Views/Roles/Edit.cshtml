@model SistemaSeguridad.Models.ViewModels.RoleViewModel

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">

            <div class="card shadow-sm border-0">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">Editar rol</h5>
                </div>
                <div class="card-body">

                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-end">
                            <a asp-action="Index" class="btn btn-outline-secondary me-2">Cancelar</a>
                            <button class="btn btn-warning text-dark" type="submit">Guardar cambios</button>
                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>
