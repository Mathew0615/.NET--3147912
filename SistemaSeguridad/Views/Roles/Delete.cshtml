@model SistemaSeguridad.Models.ViewModels.RoleViewModel

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">

            <div class="card shadow-sm border-0">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">Eliminar rol</h5>
                </div>
                <div class="card-body">

                    <p>¿Seguro que deseas eliminar el rol <strong>@Model.Name</strong>?</p>

                    @if (Model.UsersCount > 0)
                    {
                        <div class="alert alert-warning">
                            Este rol no se recomienda eliminar porque tiene usuarios asignados.
                        </div>
                    }

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />

                        <div class="d-flex justify-content-end">
                            <a asp-action="Index" class="btn btn-outline-secondary me-2">Cancelar</a>
                            <button type="submit" class="btn btn-danger">Eliminar</button>
                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>
