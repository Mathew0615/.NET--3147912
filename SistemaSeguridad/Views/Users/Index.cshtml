@model IEnumerable<SistemaSeguridad.Models.ViewModels.UserViewModel>

@{
    ViewData["Title"] = "Gestión de usuarios";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Gestión de Usuarios</h1>
            <p class="text-muted mb-0">
                Visualiza los usuarios del sistema, sus roles y estado de bloqueo.
            </p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="p-4 text-center text-muted">
                    <i class="bi bi-person-x fs-1 d-block mb-2"></i>
                    No hay usuarios registrados.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Correo</th>
                                <th>Usuario</th>
                                <th>Roles</th>
                                <th class="text-center">Bloqueado</th>
                                <th class="text-end" style="width: 280px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px;">
                                                <i class="bi bi-person text-primary"></i>
                                            </div>
                                            <div>
                                                <div class="fw-semibold">@user.Email</div>
                                                <small class="text-muted">Id: @user.Id</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@user.UserName</td>
                                    <td>
                                        @if (!user.Roles.Any())
                                        {
                                            <span class="badge bg-secondary-subtle border border-secondary-subtle text-secondary">Sin roles</span>
                                        }
                                        else
                                        {
                                            @foreach (var r in user.Roles)
                                            {
                                                <span class="badge bg-primary-subtle border border-primary-subtle text-primary me-1">@r</span>
                                            }
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (user.IsLockedOut)
                                        {
                                            <span class="badge bg-danger-subtle border border-danger-subtle text-danger">Sí</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle border border-success-subtle text-success">No</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group">
                                            <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-sm btn-outline-info">
                                                <i class="bi bi-eye"></i> Detalles
                                            </a>
                                            <a asp-action="ManageRoles" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-shield-lock"></i> Roles
                                            </a>
                                            @if (user.IsLockedOut)
                                            {
                                                <form asp-action="Unlock" asp-route-id="@user.Id" method="post" class="d-inline">
                                                    <button type="submit" class="btn btn-sm btn-outline-success">
                                                        <i class="bi bi-unlock"></i> Desbloquear
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="Lock" asp-route-id="@user.Id" method="post" class="d-inline">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="bi bi-lock"></i> Bloquear
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
